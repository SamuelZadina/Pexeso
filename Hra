<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Čtyřkartové pexeso</title>

<style>
.board {
  display: grid;
  grid-template-columns: repeat(4, 90px);
  gap: 12px;
  justify-content: center;
  max-width: 420px;
  margin: 25px auto;
}
</style>
</head>
<body>

<h1>Čtyřkartové pexeso</h1>
<p>Najdi čtyři stejné obrázky!</p>

<div class="info">
  <div class="player active" id="p1">
     Hráč 1: <span id="s1">0</span>
  </div>

  <div class="player" id="p2">
     Hráč 2: <span id="s2">0</span>
  </div>
</div>

<div id="status">Hraje hráč 1 – otoč 4 kartičky!</div>

<div class="board" id="board"></div>

<button class="restart" onclick="startGame()">
   Nová hra
</button>

<script>
const symbols = ["🐶", "🐱", "🦊", "🐼", "🦁", "🐸", "🐵", "🐰"];

let cards = [];
let selected = [];
let matched = [];
let player = 1;
let scores = [0, 0];
let locked = false;

// Spuštění nové hry
function startGame() {
  cards = [...symbols, ...symbols, ...symbols, ...symbols];

  cards.sort(() => Math.random() - 0.5);

  selected = [];
  matched = [];
  player = 1;
  scores = [0, 0];
  locked = false;

  document.getElementById("s1").textContent = 0;
  document.getElementById("s2").textContent = 0;

  
  updateStatus();
  renderCards();
}

// Vytvoření kartiček
function renderCards() {
  const board = document.getElementById("board");
  board.innerHTML = "";

  for (let i = 0; i < cards.length; i++) {
    const card = document.createElement("button");

    card.className = "card";
    card.textContent = "Tajemství";

    if (selected.includes(i) || matched.includes(i)) {
      card.textContent = cards[i];
    }

    if (matched.includes(i)) {
      card.classList.add("matched");
      card.disabled = true;
    }

    card.onclick = function() {
      flipCard(i);
    };

    board.appendChild(card);
  }
}

// Otočení kartičky
function flipCard(index) {
  if (locked || selected.includes(index) || matched.includes(index)) {
    return;
  }

  selected.push(index);
  renderCards();

  if (selected.length < 4) {
    updateStatus("Otoč ještě " + (4 - selected.length) + " kartičky!");
    return;
  }

  locked = true;

  let firstCard = cards[selected[0]];
  let isMatch = true;

  for (let i = 0; i < selected.length; i++) {
    if (cards[selected[i]] !== firstCard) {
      isMatch = false;
    }
  }

  setTimeout(function() {
    if (isMatch) {
      for (let i = 0; i < selected.length; i++) {
        matched.push(selected[i]);
      }

      scores[player - 1]++;

      document.getElementById("s" + player).textContent =
        scores[player - 1];

      updateStatus("Výborně! Získáváš bod!");
    } else {
      if (player === 1) {
        player = 2;
      } else {
        player = 1;
      }

      updateStatus();
    }

    selected = [];
    locked = false;

    renderCards();
    
    if (matched.length === cards.length) {
      finishGame();
    }
  }, 1000);
}

// Zobrazení zprávy
function updateStatus(message) {
  if (message) {
    document.getElementById("status").textContent = message;
  } else {
    document.getElementById("status").textContent =
      "Hraje hráč " + player + " – otoč 4 kartičky!";
  }
}

// Konec hry
function finishGame() {
  let result = "";

  if (scores[0] > scores[1]) {
    result = "Vyhrává hráč 1!";
  } else if (scores[1] > scores[0]) {
    result = "Vyhrává hráč 2!";
  } else {
    result = "Remíza!";
  }

  document.getElementById("status").textContent =
    "Konec hry! " + result;
}

// Spuštění hry
startGame();

</script>
</body>
</html>
